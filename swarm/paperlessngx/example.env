# General settings
uid=1000
gid=1000
timezone=America/Chicago

# Paperlessngx settings
secret_key='a_long_and_secure_secret'
client_id='a_long_and_secure_secret'
client_secret='a_long_and_secure_secret'

# Postgres settings
db_host="ip-or-hostname-of-postgres-server"
db_name=paperless
db_pass="a_secure_db_password"
db_port=5432
db_user=paperless

# Valkey settings
redis_url="redis://:a_secure_valkey_password@ip-or-hostname-of-valkey-server:6379"