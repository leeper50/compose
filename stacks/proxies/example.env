# Storage settings
data=/opt/stacks/stackname

# General settings
timezone=America/Chicago

# Image settings
gluetun_version=v3.41
socks5proxy_version=latest
tor_privoxy_version=latest

# Gluetun settings
allowed_ips=192.168.0.10
cities='comma_separated_list_of_cities'
enable_ipv6_bool=true
disable_ipv6_int=0
listen_inteface=0.0.0.0
provider='your_vpn_provider'
shadowsocks_password='secure_password'
wgkey='your_vpn_private_key'

# Proxy settings
enable_auth='true'
proxy_pass='your_pass'
proxy_user='your_user'
